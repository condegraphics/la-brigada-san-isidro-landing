DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Servir archivos y carpetas reales: img, pdf, css, js, robots.txt, sitemap.xml, llms.txt
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
</IfModule>

# ============================================================================
# 404 REAL - Antes, toda URL inexistente rewritteaba a /index.html con HTTP 200
# (soft-404): Google indexaba un espacio infinito de URLs y las tomaba por
# paginas validas, duplicando contenido y quemando crawl budget.
# Ahora cada ruta desconocida responde 404 con su pagina de error.
# ============================================================================
ErrorDocument 404 /404.html

# ============================================================================
# HARDENING CONDE GRAPHICS - Bloquear documentos internos
# Los .md son notas de trabajo/briefs internos, no contenido del sitio.
# ============================================================================
<IfModule mod_authz_core.c>
  <FilesMatch "\.(md|markdown)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "^\.gitignore$">
    Require all denied
  </FilesMatch>
</IfModule>